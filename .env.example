# ════════════════════════════════════════════════════════════════════════
# market_data_v2 — environment template
# ════════════════════════════════════════════════════════════════════════
# In a Coolify deployment these values come from the project's
# Secrets / Environment UI; the file below is the authoritative list of
# what to fill in and what each variable does.
#
# Required (no defaults):
#   CEDRO_USERNAME, CEDRO_PASSWORD, DATABASE_URL, REDIS_URL, API_TOKENS
#
# Local development: copy to `.env` (gitignored) and fill in.
# Production via Coolify: paste the values one-by-one in the UI.
# ════════════════════════════════════════════════════════════════════════


# ─── 1. Observability (both services) ──────────────────────────────────
LOG_FILTER=info             # RUST_LOG-compatible; e.g. "info,cedro_client=debug"
LOG_JSON=1                  # 1 = JSON (prod), 0 = pretty (dev)


# ─── 2. Cedro Crystal (ingest-daemon) ──────────────────────────────────
CEDRO_HOST=datafeed.cedrotech.com
CEDRO_PORT=81

# Required: feed credentials.
CEDRO_USERNAME=
CEDRO_PASSWORD=

# Software key from the contract. Leave empty if not contracted.
CEDRO_SOFTWARE_KEY=

# Socket tuning (ARCHITECTURE §5.1, §11.5). The default of 128 MB requires
# the host to set `sysctl net.core.rmem_max=134217728` first — otherwise
# the kernel silently caps the buffer and the watchdog will alert.
SO_RCVBUF=134217728
FRAME_CHANNEL_CAPACITY=2097152

# CPU pinning. Set ONLY if the host has `isolcpus=N,M` in the kernel
# cmdline. Leave empty otherwise.
# READER_CPU=0
# WATCHDOG_CPU=1


# ─── 3. Engine workers (ingest-daemon) ─────────────────────────────────
PARSER_WORKERS=8
BOOK_SHARDS=8
TRADE_BUFFER_PER_TICKER=100


# ─── 4. Fanout (NATS bundled, Redis external) ─────────────────────────
# NATS runs inside the compose with `network_mode: host`. Both services
# can reach it on localhost.
NATS_URL=nats://127.0.0.1:4222

# Redis runs on a separate instance you manage. Format:
#   redis://[:password@]host:port/db
REDIS_URL=

# Optional TTL on snapshot keys — useful so stale snapshots disappear
# if the daemon crashes during a rebuild. Leave empty for no expiry.
SNAPSHOT_TTL_SECONDS=


# ─── 5. Raw archive (ingest-daemon) ────────────────────────────────────
# Path inside the container — mounted via the `ingest-raw` volume.
RAW_ARCHIVE_DIR=/var/data/raw
RAW_ZSTD_LEVEL=3


# ─── 6. Persistence — TimescaleDB (ingest-daemon) ──────────────────────
# Required. Format: postgres://user:pass@host:port/database
DATABASE_URL=

DB_POOL_SIZE=4

# WAL is inside the container — mounted via the `ingest-wal` volume.
WAL_PATH=/var/data/trades.wal
TRADE_BATCH_SIZE=5000
TRADE_FLUSH_MS=100


# ─── 7. API server (HTTP /v1/* + WS /ws) ───────────────────────────────
# Required. Comma-separated list of bearer tokens accepted.
# Generate with: openssl rand -hex 32
API_TOKENS=

# Comma-separated CORS allowlist. Empty = permissive (DEV ONLY).
# Production: list the FQDNs of your frontends.
API_CORS_ORIGINS=

# Per-token HTTP rate limit, requests per second.
API_RATE_LIMIT=100


# ─── 8. Coolify metadata (optional) ────────────────────────────────────
# These are read by Coolify's UI when present; ignored otherwise.
# Useful for documenting which subdomain the api-server lives at.
# COOLIFY_FQDN=api.your-domain.com
